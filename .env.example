# Neon Postgres connection string (optional locally — memory store used if unset)
# Pooled URL for the API / Vercel serverless
DATABASE_URL=

# Unpooled URL — use for drizzle db:push if the pooler rejects migrations
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth) — enable under Neon Console → Branch → Auth
# Same URL for web (Vite) and API JWT verification
# Example: https://ep-xxx.neonauth.c-12.us-east-1.aws.neon.tech/neondb/auth
VITE_NEON_AUTH_URL=
NEON_AUTH_BASE_URL=
# Optional override (defaults to ${NEON_AUTH_BASE_URL}/.well-known/jwks.json)
# NEON_AUTH_JWKS_URL=

# Local geo stub so two clients on localhost can match
DEV_GEO_CITY=LocalDev
DEV_GEO_REGION=Dev
DEV_GEO_COUNTRY=XX
DEV_GEO_LAT=0
DEV_GEO_LNG=0

# API port for local `npm run dev:api`
PORT=8787

# Vercel Blob — event images + profile avatars (optional locally)
# Create a Blob store in the Vercel dashboard and paste the read-write token.
# Without it, create-event / profile save still work; upload routes return 503.
BLOB_READ_WRITE_TOKEN=
